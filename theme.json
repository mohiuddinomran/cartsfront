{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#171717"
        },
        {
          "slug": "paper",
          "name": "Paper",
          "color": "#ffffff"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#525252"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#f5f5f5"
        },
        {
          "slug": "line",
          "name": "Line",
          "color": "#d4d4d4"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "System Sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "1rem"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "1.25rem"
        },
        {
          "slug": "x-large",
          "name": "Extra Large",
          "size": "2rem"
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "3.75rem"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw",
        "vh"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "name": "XS",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "S",
          "size": "1rem"
        },
        {
          "slug": "40",
          "name": "M",
          "size": "1.5rem"
        },
        {
          "slug": "50",
          "name": "L",
          "size": "2rem"
        },
        {
          "slug": "60",
          "name": "XL",
          "size": "3rem"
        },
        {
          "slug": "70",
          "name": "2XL",
          "size": "5rem"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.65"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1rem, 4vw, 3rem)",
        "right": "clamp(1rem, 4vw, 3rem)"
      },
      "blockGap": "1.5rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.15",
          "letterSpacing": "-0.035em"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|ink"
        },
        ":hover": {
          "typography": {
            "textDecoration": "none"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|ink",
          "text": "var:preset|color|paper"
        },
        "border": {
          "radius": "2px"
        },
        "spacing": {
          "padding": {
            "top": "0.9rem",
            "bottom": "0.9rem",
            "left": "1.6rem",
            "right": "1.6rem"
          }
        },
        "typography": {
          "fontSize": "0.875rem",
          "fontWeight": "600"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontSize": "1.25rem",
          "fontWeight": "700",
          "letterSpacing": "-0.04em"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "typography": {
          "fontSize": "clamp(2rem, 5vw, 3.5rem)"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.875rem"
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var:preset|color|muted"
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "storefront",
      "title": "Storefront landing page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "commerce",
      "title": "Commerce page (wide)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "checkout",
      "title": "Checkout (minimal header)",
      "postTypes": [
        "page"
      ]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "checkout-header",
      "title": "Checkout header",
      "area": "header"
    }
  ]
}
